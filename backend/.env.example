# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=*
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_for_development_purposes_only
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
MONGODB_URI=mongodb://localhost:27017/simpex_db

# AI — NVIDIA NIM API (OpenAI-compatible)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b
