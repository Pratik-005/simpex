{
  "name": "simpex-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for AI-powered voice expense tracker Simpex",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
