    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "uuid": "^11.0.5",
    "winston": "^3.19.0",
    "zod": "^3.24.1",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1"
  },
  "devDependencies": {
